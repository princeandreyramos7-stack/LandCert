@startuml CPDO_LC_ERD

title CPDO Locational Clearance System - Entity Relationship Diagram

skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam roundcorner 5

' Define colors for different entity types
!define IDENTITY_COLOR #E3F2FD
!define CORE_COLOR #FFF9C4
!define WORKFLOW_COLOR #F3E5F5
!define AUDIT_COLOR #E8F5E9
!define RBAC_COLOR #FFE0B2
!define COMM_COLOR #FCE4EC

' ===== IDENTITY ENTITIES =====
entity "users" as users <<IDENTITY>> IDENTITY_COLOR {
  * id : INT <<PK>>
  --
  * name : VARCHAR(255)
  * email : VARCHAR(255) <<UK>>
  * password : VARCHAR(255)
  contact_number : VARCHAR(20)
  address : TEXT
  avatar_path : VARCHAR(255)
  * user_type : ENUM
  signature_path : VARCHAR(255)
  signature_url : VARCHAR(255)
  email_verified_at : TIMESTAMP
  remember_token : VARCHAR(100)
  deleted_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  user_type values:
  • applicant (default)
  • staff
  • admin
  • super_admin
}

entity "applicants" as applicants <<IDENTITY>> IDENTITY_COLOR {
  * id : BIGINT <<PK>>
  --
  * user_id : INT <<FK>> <<UK>>
  * applicant_name : VARCHAR(255)
  * applicant_address : TEXT
  * applicant_contact : VARCHAR(20)
  * applicant_type : ENUM
  deleted_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  applicant_type values:
  • individual (default)
  • corporate
}

entity "normalized_corporations" as corporations <<IDENTITY>> IDENTITY_COLOR {
  * id : BIGINT <<PK>>
  --
  * applicant_id : BIGINT <<FK>> <<UK>>
  * corporation_name : VARCHAR(255)
  * corporation_address : TEXT
  registration_number : VARCHAR(100)
  tin : VARCHAR(50)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "representatives" as representatives <<IDENTITY>> IDENTITY_COLOR {
  * id : BIGINT <<PK>>
  --
  * applicant_id : BIGINT <<FK>>
  * representative_name : VARCHAR(255)
  * representative_address : TEXT
  representative_email : VARCHAR(255)
  * representative_contact : VARCHAR(20)
  authorization_letter_path : VARCHAR(255)
  relationship : VARCHAR(100)
  * is_primary : TINYINT(1)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

' ===== CORE APPLICATION ENTITIES =====
entity "requests" as requests <<CORE>> CORE_COLOR {
  * id : BIGINT <<PK>>
  --
  * application_number : VARCHAR(50) <<UK>>
  decision_number : VARCHAR(50) <<UK>>
  * applicant_id : BIGINT <<FK>>
  user_id : INT <<FK>>
  * status : VARCHAR(50)
  has_written_notice : ENUM
  has_similar_application : ENUM
  preferred_release_mode : ENUM
  release_address : TEXT
  submission_deadline : TIMESTAMP
  submission_deadline_set_by : INT <<FK>>
  requirements_submitted_at : TIMESTAMP
  requirements_submitted_by : INT <<FK>>
  verified_requirements : JSON
  released_to_applicant_at : TIMESTAMP
  released_by : INT <<FK>>
  deleted_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  status values:
  • pending
  • approved / rejected
  • payment_confirmed
  • certificate_preparing
  • certificate_ready
  • released
}

entity "normalized_projects" as projects <<CORE>> CORE_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>> <<UK>>
  * project_type : VARCHAR(255)
  * project_nature : VARCHAR(255)
  project_nature_duration : ENUM
  project_nature_years : INT
  project_cost : DECIMAL(15,2)
  project_description : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  project_nature_duration:
  • Permanent
  • Temporary
}

entity "properties" as properties <<CORE>> CORE_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>> <<UK>>
  * lot_area_sqm : DECIMAL(10,2)
  bldg_improvement_sqm : DECIMAL(10,2)
  lot_number : VARCHAR(100)
  tax_declaration_no : VARCHAR(100)
  zone_classification : VARCHAR(100)
  title_number : VARCHAR(100)
  right_over_land : ENUM
  existing_land_use : ENUM
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  right_over_land:
  • Owner
  • Lessee
  
  existing_land_use:
  • Residential
  • Commercial
  • Industrial
  • Agricultural, etc.
}

entity "locations" as locations <<CORE>> CORE_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>> <<UK>>
  * street_address : VARCHAR(255)
  * barangay : VARCHAR(100)
  * city_municipality : VARCHAR(100)
  * province : VARCHAR(100)
  postal_code : VARCHAR(10)
  district : VARCHAR(50)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "requirement_documents" as documents <<CORE>> CORE_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>>
  * requirement_id : INT
  * requirement_name : VARCHAR(255)
  * file_path : VARCHAR(500)
  * original_filename : VARCHAR(255)
  mime_type : VARCHAR(100)
  file_size : INT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

' ===== WORKFLOW ENTITIES =====
entity "reports" as reports <<WORKFLOW>> WORKFLOW_COLOR {
  * report_id : INT <<PK>>
  --
  * request_id : BIGINT <<FK>>
  description : TEXT
  payment_amount : DECIMAL(10,2)
  requirements : JSON
  admin_notes : TEXT
  * evaluation : ENUM
  approved_by : VARCHAR(255)
  approved_at : TIMESTAMP
  date_certified : DATE
  amount : DECIMAL(12,2)
  date_reported : DATETIME
  issued_by : VARCHAR(255)
  reviewed_by : BIGINT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  evaluation values:
  • pending
  • approved
  • rejected
  • reviewed
}

entity "payments" as payments <<WORKFLOW>> WORKFLOW_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>>
  user_id : INT <<FK>>
  * amount : DECIMAL(10,2)
  * payment_method : ENUM
  receipt_number : VARCHAR(100)
  receipt_file_path : VARCHAR(255)
  * payment_date : DATE
  * payment_status : ENUM
  verified_by : INT <<FK>>
  verified_at : TIMESTAMP
  rejection_reason : TEXT
  * is_legacy_payment : TINYINT(1)
  deleted_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  payment_method:
  • cash
  
  payment_status:
  • pending (default)
  • verified
  • rejected
  
  CHECK: amount > 0
}

entity "certificates" as certificates <<WORKFLOW>> WORKFLOW_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>>
  * user_id : INT <<FK>>
  payment_id : BIGINT <<UK>>
  * certificate_number : VARCHAR(50) <<UK>>
  physical_certificate_number : VARCHAR(50)
  * status : ENUM
  ready_for_collection_at : TIMESTAMP
  ready_for_collection_by : INT <<FK>>
  collected_at : TIMESTAMP
  collected_by_staff : INT <<FK>>
  issued_by : INT <<FK>>
  issued_at : TIMESTAMP
  released_at : TIMESTAMP
  released_by : INT <<FK>>
  released_to_name : VARCHAR(255)
  released_to_id_type : VARCHAR(50)
  released_to_id_number : VARCHAR(100)
  release_signature_path : VARCHAR(255)
  valid_until : DATE
  * is_legacy_certificate : TINYINT(1)
  deleted_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  status values:
  • preparing (default)
  • ready_for_pickup
  • released
  • cancelled
}

entity "request_timeline" as timeline <<WORKFLOW>> WORKFLOW_COLOR {
  * id : BIGINT <<PK>>
  --
  * request_id : BIGINT <<FK>>
  * event_type : VARCHAR(50)
  old_status : VARCHAR(50)
  new_status : VARCHAR(50)
  * title : VARCHAR(255)
  description : TEXT
  metadata : JSON
  user_id : INT <<FK>>
  user_role : VARCHAR(50)
  * visible_to_applicant : TINYINT(1)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

' ===== AUDIT & COMMUNICATION ENTITIES =====
entity "audit_logs" as audit <<AUDIT>> AUDIT_COLOR {
  * id : BIGINT <<PK>>
  --
  user_id : INT <<FK>>
  * action : VARCHAR(255)
  model_type : VARCHAR(255)
  model_id : BIGINT
  old_values : JSON
  new_values : JSON
  metadata : JSON
  ip_address : VARCHAR(45)
  user_agent : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "notifications" as notifications <<COMM>> COMM_COLOR {
  * id : BIGINT <<PK>>
  --
  * user_id : INT <<FK>>
  * type : VARCHAR(255)
  * title : VARCHAR(255)
  * message : TEXT
  data : JSON
  * read : TINYINT(1)
  read_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "reminders" as reminders <<COMM>> COMM_COLOR {
  * id : BIGINT <<PK>>
  --
  * user_id : INT <<FK>>
  * type : VARCHAR(50)
  related_id : BIGINT
  related_type : VARCHAR(255)
  * scheduled_at : TIMESTAMP
  * status : ENUM
  sent_at : TIMESTAMP
  error_message : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  status values:
  • pending (default)
  • sent
  • failed
}

entity "sms_templates" as sms <<COMM>> COMM_COLOR {
  * id : BIGINT <<PK>>
  --
  * event_key : VARCHAR(100) <<UK>>
  * event_label : VARCHAR(255)
  * message : TEXT
  * enabled : TINYINT(1)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  event_key values:
  • application_submitted
  • application_approved
  • payment_verified
  • certificate_ready, etc.
}

' ===== RBAC ENTITIES =====
entity "roles" as roles <<RBAC>> RBAC_COLOR {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(255)
  * guard_name : VARCHAR(255)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  UNIQUE(name, guard_name)
  
  Roles:
  • applicant
  • admin
  • super_admin
}

entity "permissions" as permissions <<RBAC>> RBAC_COLOR {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(255)
  * guard_name : VARCHAR(255)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  UNIQUE(name, guard_name)
}

entity "role_has_permissions" as role_perms <<RBAC>> RBAC_COLOR {
  * permission_id : BIGINT <<PK,FK>>
  * role_id : BIGINT <<PK,FK>>
}

entity "model_has_roles" as model_roles <<RBAC>> RBAC_COLOR {
  * role_id : BIGINT <<PK,FK>>
  * model_type : VARCHAR(255) <<PK>>
  * model_id : BIGINT <<PK>>
}

entity "model_has_permissions" as model_perms <<RBAC>> RBAC_COLOR {
  * permission_id : BIGINT <<PK,FK>>
  * model_type : VARCHAR(255) <<PK>>
  * model_id : BIGINT <<PK>>
}

' ===== CONFIGURATION ENTITIES =====
entity "system_settings" as settings <<CONFIG>> AUDIT_COLOR {
  * id : BIGINT <<PK>>
  --
  * setting_key : VARCHAR(100) <<UK>>
  * category : VARCHAR(50)
  value : TEXT
  * type : VARCHAR(50)
  * is_public : TINYINT(1)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  Categories:
  • General
  • System
  • Uploads
  • Certificates
  • Notifications
  • Payments
}

entity "dashboard_analytics" as analytics <<REPORTING>> AUDIT_COLOR {
  * id : BIGINT <<PK>>
  --
  * date : DATE
  * metric_type : VARCHAR(50)
  total_requests : INT
  total_payment_amount : DECIMAL(15,2)
  requests_by_type : JSON
  requests_by_nature : JSON
  metadata : JSON
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
  ..
  UNIQUE(date, metric_type)
}

' ===== RELATIONSHIPS =====

' Identity relationships
users ||--o| applicants : "1:1\nprofile"
applicants ||--o| corporations : "1:1\ncorporate details"
applicants ||--o{ representatives : "1:N\nauthorized reps"
users ||--o{ requests : "1:N\nsubmits"

' Request relationships (core aggregates)
applicants ||--o{ requests : "1:N\nfiles applications"
requests ||--|| projects : "1:1\nproject details"
requests ||--|| properties : "1:1\nproperty info"
requests ||--|| locations : "1:1\nlocation"
requests ||--o{ documents : "1:N\nattachments"

' Workflow relationships
requests ||--o{ reports : "1:N\nevaluations"
requests ||--o{ payments : "1:N\nbilled"
requests ||--o{ certificates : "1:N\ncertificates"
requests ||--o{ timeline : "1:N\naudit trail"

' Payment & Certificate
payments ||--o| certificates : "1:1\nissued for"

' User action relationships
users ||--o{ payments : "verifies"
users ||--o{ certificates : "issues/releases"
users ||--o{ timeline : "performs action"

' Audit & Communications
users ||--o{ audit : "1:N\nactivity logged"
users ||--o{ notifications : "1:N\nreceives"
users ||--o{ reminders : "1:N\nscheduled for"

' RBAC relationships
roles ||--o{ role_perms : "has permissions"
permissions ||--o{ role_perms : "granted to roles"
roles ||--o{ model_roles : "assigned to"
permissions ||--o{ model_perms : "assigned to"
users }o--o{ model_roles : "polymorphic"
users }o--o{ model_perms : "polymorphic"

' Foreign key references for staff actions
users ||..o{ requests : "released_by"
users ||..o{ requests : "submission_deadline_set_by"
users ||..o{ requests : "requirements_submitted_by"
users ||..o{ certificates : "ready_for_collection_by"
users ||..o{ certificates : "collected_by_staff"
users ||..o{ certificates : "issued_by"
users ||..o{ certificates : "released_by"

' Notes
note top of users
  Central identity table.
  Supports soft deletes.
  Contains signature_url for
  e-signature functionality.
end note

note top of requests
  Aggregate root for applications.
  Status drives workflow:
  pending → approved → payment_confirmed
  → certificate_preparing → certificate_ready
  → released
end note

note bottom of certificates
  One certificate per payment.
  Tracks full lifecycle from
  preparation to release.
end note

note right of timeline
  Visible audit trail for
  applicants showing request
  progress and status changes.
end note

note left of roles
  Spatie Laravel-Permission
  package implementation.
  
  3 roles:
  • applicant
  • admin
  • super_admin
end note

legend right
  |= Color |= Entity Type |
  | <back:IDENTITY_COLOR>  </back> | Identity & Users |
  | <back:CORE_COLOR>  </back> | Core Application |
  | <back:WORKFLOW_COLOR>  </back> | Workflow |
  | <back:AUDIT_COLOR>  </back> | Audit & Config |
  | <back:RBAC_COLOR>  </back> | RBAC (Spatie) |
  | <back:COMM_COLOR>  </back> | Communications |
  
  **Cardinality Notation:**
  ||--|| : One to One
  ||--o{ : One to Many
  }o--o{ : Many to Many
  ||..o{ : Optional FK reference
endlegend

@enduml
